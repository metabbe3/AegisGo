# systemd unit for aegis-serve — copy to /etc/systemd/system/ and adjust
# User, WorkingDirectory, and the Environment lines to the deployment.
# Provider/model are env-driven so the same binary serves every environment.

[Unit]
Description=AegisGo agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
# File tools are sandboxed to this directory.
WorkingDirectory=/opt/aegisgo/workspace
# Pick ONE provider block; this example is OpenAI.
# For a local model instead: provider=openai-compat,
# OPENAI_BASE_URL=http://localhost:11434/v1 (Ollama), model=llama3.
# Provider outage? AEGIS_LLM=off degrades to router-only mode instead of
# an outage — deterministic commands keep answering with zero credentials.
Environment=AEGIS_PROVIDER=openai
Environment=AEGIS_MODEL=gpt-4o-mini
Environment=AEGIS_MODEL_FAST=gpt-4o-mini
Environment=AEGIS_MODEL_SMART=gpt-4o
Environment=AEGIS_WORKSPACE=/opt/aegisgo/workspace
Environment=AEGIS_ADDR=:8080
Environment=AEGIS_DB_PATH=/opt/aegisgo/state/aegisgo.db
Environment=AEGIS_SQL_MODE=ro
Environment=AEGIS_RULES_RELOAD=30
# Telegram interface — dormant until the token is set.
# Long-poll mode (zero ingress) needs only these two:
#Environment=AEGIS_TELEGRAM_TOKEN=
#Environment=AEGIS_TELEGRAM_CHATS=
# Webhook mode (public TLS ingress) additionally:
#Environment=AEGIS_TELEGRAM_WEBHOOK_URL=https://bot.example.com
# Environment=AEGIS_MCP_SERVERS=stdio:/usr/local/bin/some-mcp-server
# Secrets: use an EnvironmentFile readable only by this user.
EnvironmentFile=-/etc/aegisgo.env
ExecStart=/opt/aegisgo/bin/aegis-serve
Restart=on-failure
RestartSec=3

# Lightweight-by-design hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aegisgo/workspace /opt/aegisgo/state
PrivateTmp=true

[Install]
WantedBy=multi-user.target
